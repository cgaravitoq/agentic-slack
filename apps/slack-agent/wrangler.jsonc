{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agentic-slack",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  },
  "limits": { "cpu_ms": 30000 },
  "d1_databases": [{ "binding": "DB" }],
  // Flue injects the Durable Object binding at build time, not the SQLite
  // class migration. Removing this tag deploys a DO without storage.
  "migrations": [
    {
      "tag": "flue-class-FlueSlackAgentAgent",
      "new_sqlite_classes": ["FlueSlackAgentAgent"]
    }
  ],
  // Bindings are not inherited by environments, so staging repeats ai and
  // d1_databases.
  "env": {
    "staging": {
      "name": "agentic-slack-staging",
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentic-slack-staging",
          "database_id": "44078cb4-e76b-4b2d-b90e-e7dc0138fdbe"
        }
      ]
    }
  }
}
