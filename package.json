{
  "name": "agentic-slack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint": "oxlint . --type-aware --deny typescript/no-floating-promises",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "deploy:dry": "wrangler deploy --dry-run --config apps/slack-agent/wrangler.jsonc",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run deploy:dry"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "wrangler": "4.122.0"
  },
  "trustedDependencies": []
}
