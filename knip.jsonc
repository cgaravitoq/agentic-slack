{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "includeEntryExports": true,
  "ignoreDependencies": [
    // Specifier cloudflare:workers is a Workers runtime virtual module.
    "cloudflare"
  ],
  "workspaces": {
    "apps/slack-agent": {
      // The `!` suffix marks a production entry: Flue builds the Worker from
      // the `app` path in flue.config.ts, and wrangler.jsonc has no `main`
      // because Flue injects it at build time, so Knip cannot infer either.
      "entry": ["flue.config.ts", "src/index.ts!"]
    }
  }
}
